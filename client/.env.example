# Copy this file to .env.local and fill it in. Git ignores .env.local.
#
# Both settings are optional. Without them the app starts with no leagues and
# no manager, and you add a league by pasting its ID into the settings screen.

# The Sleeper leagues this copy starts out knowing about, as JSON.
# The ID is the long run of digits in your league's Sleeper web address.
# A league ID is enough to look the league up, so keep this out of git.
VITE_SEED_LEAGUES=[{"id":"1234567890123456789","name":"My League"}]

# Your Sleeper display name, so a league you load already knows which seat is
# yours. You can also choose your seat in the app, which is what most people do.
VITE_DEFAULT_MANAGER=YourSleeperName

# Where the client sends /api during `npm run dev`. The default is right for a
# normal local run and you only need this if you move the data service.
# VITE_API_TARGET=http://localhost:5178
